<group name="wireshark_network,">

  <!-- Parent rule: decodes JSON events emitted by wireshark_to_wazuh.py (level 0, never alerts) -->
  <rule id="100000" level="0">
    <decoded_as>json</decoded_as>
    <field name="event_type">network_traffic</field>
    <description>Wireshark network traffic events</description>
  </rule>

  <!-- Generic rule: any network_traffic event not matched by a more specific rule below -->
  <rule id="100004" level="5">
    <if_sid>100000</if_sid>
    <description>Network Traffic Analysis Alert</description>
    <group>network_traffic,analysis,</group>
  </rule>

  <!-- Specific rules: children of the generic rule -->
  <rule id="100001" level="3">
    <if_sid>100004</if_sid>
    <field name="dst_ip">162.159.141.124</field>
    <description>Cloudflare CDN Traffic - Legitimate CDN (AS13335)</description>
    <group>network_traffic,cdn_detection,</group>
  </rule>

  <rule id="100002" level="3">
    <if_sid>100004</if_sid>
    <field name="dst_ip">160.79.104.10</field>
    <description>Anthropic CDN Traffic - claude.ai Access</description>
    <group>network_traffic,cdn_detection,</group>
  </rule>

  <!-- Encrypted traffic: the protocol label comes from the highest layer dissected by tshark -->
  <rule id="100003" level="3">
    <if_sid>100004</if_sid>
    <match>"protocol": "TLS"|"protocol": "QUIC"</match>
    <description>Encrypted Traffic (TLS/QUIC)</description>
    <group>network_traffic,encrypted_traffic,</group>
  </rule>

</group>